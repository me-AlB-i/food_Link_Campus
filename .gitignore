# ==========================================
# FoodLink Campus - .gitignore
# SECURITY: Files listed here won't be uploaded
# ==========================================

# ============ SENSITIVE FILES ============
# NEVER COMMIT THESE - Contains passwords/keys
.env
.env.local
.env.*.local
*.env
firebase-service-account.json
food-link-campus*.json
*-credentials.json
*-service-account.json
*.pem
*.key
secrets/

# ============ PYTHON / DJANGO ============
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec

# Virtual environments
venv/
ENV/
env/
.venv/

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
/media/
staticfiles/

# ============ NODE / FRONTEND ============
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build output
/frontend/dist/
/frontend/build/

# ============ IDE / EDITORS ============
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# ============ OS FILES ============
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ============ MISC ============
*.bak
*.tmp
*.temp
.cache/
*.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
