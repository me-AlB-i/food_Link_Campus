# FoodLink Campus Frontend - Environment Variables
# =================================================
# IMPORTANT: This file is for LOCAL development only
# On Netlify, set these in Site Settings > Environment Variables
# =================================================

# Backend API URL - Change this to your deployed backend URL
VITE_API_URL=https://your-backend-url.onrender.com/api

# Optional: Google Maps API Key (if needed on frontend)
# VITE_GOOGLE_MAPS_KEY=your_key_here
